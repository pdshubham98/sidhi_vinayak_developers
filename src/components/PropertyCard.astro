---
import type { Property } from '../lib/properties';
import { typeLabels, statusLabels, ownershipLabels, formatPrice } from '../lib/properties';
import { url } from '../lib/url';

interface Props {
  property: Property;
  /** Show the "Book site visit" CTA button on the card. Default true. */
  showCta?: boolean;
}
const { property: p, showCta = true } = Astro.props;
const id = p.id;
const { title, type, status, location, price, size, offer, summary, images, sample, ownershipType } = p.data;
const image = images?.[0];
const statusClass = {
  available: 'badge-available',
  booked: 'badge-booked',
  sold: 'badge-sold',
  upcoming: 'badge-upcoming',
}[status];

const needParam = type === 'farm-house-plot' ? 'farm-house' : 'plot';
const isAvailable = status === 'available' || status === 'upcoming';
---

<article class="property-card" data-type={type} data-status={status}>
  <a href={url(`/properties/${id}`)} class="property-card__image" tabindex="-1" aria-hidden="true">
    {image ? (
      <img src={image.src} alt={image.alt} loading="lazy" width="640" height="400" />
    ) : (
      <div style="width:100%;height:100%;background:var(--sage);" aria-hidden="true"></div>
    )}
    {image?.placeholder && (
      <div class="property-card__photo-tag">
        <span class="badge badge-sample">Photo coming soon</span>
      </div>
    )}
  </a>

  <div class="property-card__body">
    <div class="property-card__meta">
      <span class={`badge ${statusClass}`}>{statusLabels[status]}</span>
      <span class="badge badge-type">{typeLabels[type]}</span>
      {ownershipType === 'own' && <span class="badge badge-own">Our project</span>}
      {sample && <span class="badge badge-sample">Sample listing</span>}
    </div>

    <h3 class="property-card__title">
      <a href={url(`/properties/${id}`)}>{title}</a>
    </h3>

    <p class="property-card__location">
      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:inline;vertical-align:middle;margin-right:3px;margin-top:-2px;flex-shrink:0;"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>{location}
    </p>

    {summary && <p style="font-size:0.875rem;color:var(--muted);line-height:1.5;">{summary}</p>}

    <div class="property-card__footer">
      <div>
        <span class="property-card__price">{formatPrice(price)}</span>
        {size && <span class="property-card__size">{size}</span>}
      </div>
      {offer && <span class="property-card__offer">{offer}</span>}
    </div>

    {showCta && isAvailable && (
      <div class="property-card__cta">
        <a href={url(`/requirement?need=${needParam}`)} class="btn btn-primary" style="width:100%;justify-content:center;font-size:0.9rem;min-height:44px;">
          Book a site visit
        </a>
        <a href={url(`/properties/${id}`)} style="display:block;text-align:center;font-size:0.85rem;color:var(--forest);font-weight:600;margin-top:0.4rem;">
          View details
        </a>
      </div>
    )}
    {showCta && !isAvailable && (
      <div class="property-card__cta">
        <a href={url(`/properties/${id}`)} class="btn btn-ghost" style="width:100%;justify-content:center;font-size:0.9rem;min-height:44px;">
          View details
        </a>
      </div>
    )}
  </div>
</article>

<style>
  .property-card__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
  }
  .property-card__cta {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
  }
  .badge-type { background: var(--grey-light); color: var(--muted); }
  .badge-own { background: var(--ochre-light); color: #7a5a1a; font-weight: 600; }
</style>
