---
// Signature hero illustration: plot layout plan
// Plots on either side of an internal road, trees, one plot highlighted in ochre.
// Animates on load respecting prefers-reduced-motion.
---

<svg
  viewBox="0 0 560 360"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Illustration of a farm house plot layout with an internal road and trees"
  class="plot-grid"
  style="width:100%;height:auto;max-height:360px;"
>
  <defs>
    <style>
      @media (prefers-reduced-motion: no-preference) {
        .plot-grid .plot-outline { animation: draw-in 1.2s ease forwards; stroke-dasharray: 400; stroke-dashoffset: 400; }
        .plot-grid .plot-fill    { animation: fade-in 0.6s ease 1s forwards; opacity: 0; }
        .plot-grid .tree         { animation: pop-in 0.4s ease backwards; }
        .plot-grid .road-mark    { animation: fade-in 0.8s ease 0.4s forwards; opacity: 0; }
        @keyframes draw-in   { to { stroke-dashoffset: 0; } }
        @keyframes fade-in   { to { opacity: 1; } }
        @keyframes pop-in    { from { transform-box: fill-box; transform-origin: 50% 100%; transform: scaleY(0); opacity:0; } to { transform-box: fill-box; transform-origin: 50% 100%; transform: scaleY(1); opacity:1; } }
        .plot-grid .tree:nth-child(1) { animation-delay: 1.1s; }
        .plot-grid .tree:nth-child(2) { animation-delay: 1.2s; }
        .plot-grid .tree:nth-child(3) { animation-delay: 1.3s; }
        .plot-grid .tree:nth-child(4) { animation-delay: 1.4s; }
        .plot-grid .tree:nth-child(5) { animation-delay: 1.5s; }
        .plot-grid .tree:nth-child(6) { animation-delay: 1.6s; }
        .plot-grid .tree:nth-child(7) { animation-delay: 1.7s; }
        .plot-grid .tree:nth-child(8) { animation-delay: 1.8s; }
      }
    </style>
    <!-- Tree symbol -->
    <g id="tree">
      <ellipse cx="0" cy="-10" rx="10" ry="13" fill="#2d6b4a" opacity="0.85"/>
      <rect x="-2" y="2" width="4" height="7" rx="1" fill="#1a4a2e"/>
    </g>
  </defs>

  <!-- Background -->
  <rect width="560" height="360" fill="#1e4a30" rx="8"/>

  <!-- Grass areas -->
  <rect x="0" y="0" width="560" height="360" rx="8" fill="#1e4a30"/>

  <!-- Road (horizontal, centre) -->
  <rect x="0" y="155" width="560" height="50" fill="#2c3e30"/>
  <!-- Road markings -->
  <g class="road-mark">
    <rect x="50"  y="178" width="40" height="4" rx="2" fill="rgba(255,255,255,0.25)"/>
    <rect x="130" y="178" width="40" height="4" rx="2" fill="rgba(255,255,255,0.25)"/>
    <rect x="210" y="178" width="40" height="4" rx="2" fill="rgba(255,255,255,0.25)"/>
    <rect x="290" y="178" width="40" height="4" rx="2" fill="rgba(255,255,255,0.25)"/>
    <rect x="370" y="178" width="40" height="4" rx="2" fill="rgba(255,255,255,0.25)"/>
    <rect x="450" y="178" width="40" height="4" rx="2" fill="rgba(255,255,255,0.25)"/>
  </g>

  <!-- Plots — top row (6 plots) -->
  <!-- Plot 1 (highlighted in ochre) -->
  <rect class="plot-fill" x="14"  y="14"  width="78" height="130" rx="4" fill="#C8862E" opacity="0.9"/>
  <rect class="plot-outline" x="14"  y="14"  width="78" height="130" rx="4" fill="none" stroke="#fff" stroke-width="1.5"/>
  <text x="53" y="85" text-anchor="middle" font-family="sans-serif" font-size="9" fill="#fff" font-weight="bold" opacity="0.9">VATIKA</text>
  <text x="53" y="98" text-anchor="middle" font-family="sans-serif" font-size="9" fill="#fff" opacity="0.9">GREEN</text>

  <!-- Plots 2–6, top -->
  <rect class="plot-fill" x="102" y="14"  width="78" height="130" rx="4" fill="#275c3e" opacity="0.85"/>
  <rect class="plot-outline" x="102" y="14"  width="78" height="130" rx="4" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"/>

  <rect class="plot-fill" x="190" y="14"  width="78" height="130" rx="4" fill="#275c3e" opacity="0.85"/>
  <rect class="plot-outline" x="190" y="14"  width="78" height="130" rx="4" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"/>

  <rect class="plot-fill" x="278" y="14"  width="78" height="130" rx="4" fill="#275c3e" opacity="0.85"/>
  <rect class="plot-outline" x="278" y="14"  width="78" height="130" rx="4" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"/>

  <rect class="plot-fill" x="366" y="14"  width="78" height="130" rx="4" fill="#275c3e" opacity="0.85"/>
  <rect class="plot-outline" x="366" y="14"  width="78" height="130" rx="4" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"/>

  <rect class="plot-fill" x="454" y="14"  width="92" height="130" rx="4" fill="#275c3e" opacity="0.85"/>
  <rect class="plot-outline" x="454" y="14"  width="92" height="130" rx="4" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"/>

  <!-- Plots — bottom row (6 plots) -->
  <rect class="plot-fill" x="14"  y="216" width="78" height="130" rx="4" fill="#275c3e" opacity="0.85"/>
  <rect class="plot-outline" x="14"  y="216" width="78" height="130" rx="4" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"/>

  <rect class="plot-fill" x="102" y="216" width="78" height="130" rx="4" fill="#275c3e" opacity="0.85"/>
  <rect class="plot-outline" x="102" y="216" width="78" height="130" rx="4" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"/>

  <rect class="plot-fill" x="190" y="216" width="78" height="130" rx="4" fill="#275c3e" opacity="0.85"/>
  <rect class="plot-outline" x="190" y="216" width="78" height="130" rx="4" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"/>

  <rect class="plot-fill" x="278" y="216" width="78" height="130" rx="4" fill="#275c3e" opacity="0.85"/>
  <rect class="plot-outline" x="278" y="216" width="78" height="130" rx="4" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"/>

  <rect class="plot-fill" x="366" y="216" width="78" height="130" rx="4" fill="#275c3e" opacity="0.85"/>
  <rect class="plot-outline" x="366" y="216" width="78" height="130" rx="4" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"/>

  <rect class="plot-fill" x="454" y="216" width="92" height="130" rx="4" fill="#275c3e" opacity="0.85"/>
  <rect class="plot-outline" x="454" y="216" width="92" height="130" rx="4" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"/>

  <!-- Trees along road edges -->
  <g class="tree"><use href="#tree" x="55"  y="154"/></g>
  <g class="tree"><use href="#tree" x="141" y="154"/></g>
  <g class="tree"><use href="#tree" x="229" y="154"/></g>
  <g class="tree"><use href="#tree" x="317" y="154"/></g>
  <g class="tree"><use href="#tree" x="405" y="154"/></g>
  <g class="tree"><use href="#tree" x="505" y="154"/></g>
  <g class="tree"><use href="#tree" x="55"  y="207"/></g>
  <g class="tree"><use href="#tree" x="141" y="207"/></g>
  <g class="tree"><use href="#tree" x="229" y="207"/></g>
  <g class="tree"><use href="#tree" x="317" y="207"/></g>
  <g class="tree"><use href="#tree" x="405" y="207"/></g>
  <g class="tree"><use href="#tree" x="505" y="207"/></g>

  <!-- Road label -->
  <text x="280" y="174" text-anchor="middle" font-family="sans-serif" font-size="9" fill="rgba(255,255,255,0.5)" letter-spacing="2">INTERNAL ROAD</text>
</svg>
