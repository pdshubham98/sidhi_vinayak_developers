---
import { site, telHref, whatsappHref } from '../config/site';
import { url } from '../lib/url';
const hasPhone = !!site.contact.phone;
const hasWhatsapp = !!site.contact.whatsapp;
---

{(hasPhone || hasWhatsapp) && (
  <div class="mobile-bar" role="navigation" aria-label="Quick contact">
    {hasPhone && (
      <a href={telHref(site.contact.phone)} class="btn btn-outline">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.15 12 19.79 19.79 0 0 1 1.08 3.45 2 2 0 0 1 3.06 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Call
      </a>
    )}
    {hasWhatsapp && (
      <a
        href={whatsappHref(site.contact.whatsapp, "Hi, I'm interested in a property.")}
        class="btn btn-primary"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.38 1.25 4.79L2.05 22l5.42-1.42c1.35.73 2.9 1.14 4.56 1.14h.01c5.45 0 9.9-4.45 9.9-9.91S17.49 2 12.04 2zm0 18.13c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.24 8.24 0 0 1-1.26-4.37c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c-.01 4.54-3.7 8.22-8.22 8.22zm4.52-6.16c-.25-.12-1.47-.72-1.69-.8-.23-.08-.39-.12-.56.12-.17.25-.64.8-.78 1-.15.2-.29.21-.54.08-.25-.12-.95-.35-1.8-.11-.69.21-1.12.69-1.29.9-.17.21-.09.31.09.41.27.14 1.42.92 1.97 2.17.54 1.24-.39 2.64-.52 2.83-.13.2-.39.25-.58.16-.2-.09-.82-.3-1.56-.95-.58-.52-.97-1.16-1.08-1.35-.11-.2-.01-.3.09-.4.09-.09.2-.24.3-.35.1-.12.13-.2.2-.33.06-.14.03-.26-.02-.35-.05-.1-.56-1.35-.77-1.85-.2-.49-.4-.42-.56-.43-.14-.01-.31-.01-.47-.01-.17 0-.44.06-.66.31-.23.25-.87.85-.87 2.07s.89 2.4 1.01 2.57c.13.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.23-.15-.48-.27z"/></svg>
        WhatsApp
      </a>
    )}
    <a href={url('/requirement')} class="btn btn-ghost">
      <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      Enquire
    </a>
  </div>
)}

{!hasPhone && !hasWhatsapp && (
  <div class="mobile-bar" role="navigation" aria-label="Quick contact">
    <a href={url('/requirement')} class="btn btn-primary">Enquire now</a>
  </div>
)}
