---
interface Props {
  id: string;
  label: string;
  type?: 'text' | 'tel' | 'email' | 'textarea';
  name?: string;
  required?: boolean;
  value?: string;
  placeholder?: string;
  error?: string;
  hint?: string;
  autocomplete?: string;
  rows?: number;
}

const {
  id,
  label,
  type = 'text',
  name = id,
  required = false,
  value = '',
  placeholder = '',
  error,
  hint,
  autocomplete,
  rows = 4,
} = Astro.props;

const errorId = `${id}-error`;
const hintId  = `${id}-hint`;
const describedBy = [error ? errorId : '', hint ? hintId : ''].filter(Boolean).join(' ') || undefined;
---

<div class="form-group">
  <label for={id}>
    {label}
    {required && <span class="required" aria-hidden="true">*</span>}
  </label>

  {hint && <p id={hintId} style="font-size:0.875rem;color:#4a6054;margin-bottom:0.1rem;">{hint}</p>}

  {type === 'textarea' ? (
    <textarea
      id={id}
      name={name}
      class="field-textarea"
      rows={rows}
      aria-required={required ? 'true' : undefined}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={describedBy}
      placeholder={placeholder}
    >{value}</textarea>
  ) : (
    <input
      id={id}
      name={name}
      type={type}
      class="field-input"
      value={value}
      placeholder={placeholder}
      aria-required={required ? 'true' : undefined}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={describedBy}
      autocomplete={autocomplete}
    />
  )}

  {error && <p id={errorId} class="field-error" role="alert">{error}</p>}
</div>
