---
import { site, telHref, whatsappHref } from '../config/site';
import { url } from '../lib/url';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <!-- Brand -->
      <div>
        <a href={url('/')} class="site-footer__logo">{site.name}</a>
        <p>{site.tagline}</p>
        {site.contact.hours && <p style="margin-top:0.5rem;color:rgba(255,255,255,0.55);">{site.contact.hours}</p>}
      </div>

      <!-- Office -->
      <div>
        <h4>{site.office.label}</h4>
        <address>
          {site.office.lines.map(l => <>{l}<br /></>)}
        </address>
        {site.office.mapUrl && (
          <a href={site.office.mapUrl} target="_blank" rel="noopener noreferrer" style="margin-top:0.5rem;display:inline-block;font-size:0.85rem;">
            View on Google Maps
          </a>
        )}
      </div>

      <!-- Contact -->
      <div>
        <h4>Contact</h4>
        {site.contact.phone && (
          <p><a href={telHref(site.contact.phone)}>{site.contact.phone}</a></p>
        )}
        {site.contact.whatsapp && (
          <p>
            <a href={whatsappHref(site.contact.whatsapp, `Hi, I'm interested in a property.`)}>
              WhatsApp
            </a>
          </p>
        )}
        {site.contact.email && (
          <p><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
        )}
      </div>

      <!-- Links -->
      <div>
        <h4>Explore</h4>
        <ul class="site-footer__links">
          <li><a href={url('/properties')}>Our projects</a></li>
          <li><a href={url('/plots-in-neelbad-bhopal')}>Plots in Neelbad</a></li>
          <li><a href={url('/farm-house-plots-bilkisganj')}>Farm house plots</a></li>
          <li><a href={url('/buying-a-plot-in-bhopal')}>Buying a plot</a></li>
          <li><a href={url('/construction')}>Construction</a></li>
          <li><a href={url('/sell')}>Sell property</a></li>
          <li><a href={url('/about')}>About us</a></li>
          <li><a href={url('/faq')}>FAQ</a></li>
          <li><a href={url('/contact')}>Contact</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <span>© {year} {site.name}</span>
      <a href={url('/privacy')}>Privacy policy</a>
    </div>
  </div>
</footer>
