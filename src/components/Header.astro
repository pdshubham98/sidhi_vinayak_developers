---
import { site } from '../config/site';
import { url } from '../lib/url';
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const is = (p: string) => {
  const full = base + p;
  return path === full || path === full + '/' ? 'page' : undefined;
};
---

<header class="site-header">
  <div class="container">
    <div class="site-header__inner">
      <a href={url('/')} class="site-header__logo" aria-label={site.name + ' – home'}>
        <img src={url('/images/logo.png')} alt={site.name + ' logo'} class="logo-img" width="44" height="44" />
        <span class="logo-name">Sidhivinayak<br/><span class="logo-name-sub">Developers</span></span>
      </a>

      <button
        class="menu-toggle"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="Open navigation menu"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect class="bar bar1" x="3" y="5" width="18" height="2" rx="1" fill="currentColor" />
          <rect class="bar bar2" x="3" y="11" width="18" height="2" rx="1" fill="currentColor" />
          <rect class="bar bar3" x="3" y="17" width="18" height="2" rx="1" fill="currentColor" />
        </svg>
      </button>

      <nav class="site-nav" id="site-nav" aria-label="Main navigation">
        <a href={url('/properties')} aria-current={is('/properties')}>Properties</a>
        <a href={url('/construction')} aria-current={is('/construction')}>Construction</a>
        <a href={url('/sell')} aria-current={is('/sell')}>Sell Property</a>
        <a href={url('/about')} aria-current={is('/about')}>About</a>
        <a href={url('/contact')} aria-current={is('/contact')}>Contact</a>
        <a href={url('/requirement')} class="btn btn-primary nav-cta">Book Site Visit</a>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header__logo { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; }
  .logo-img { height: 44px; width: 44px; display: block; object-fit: contain; flex-shrink: 0; }
  .logo-name { font-family: 'Young Serif', serif; font-size: 1rem; line-height: 1.15; color: var(--forest-deep); letter-spacing: 0.01em; }
  .logo-name-sub { font-size: 0.75rem; color: var(--ochre); font-family: 'Mukta', sans-serif; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
  .nav-cta { padding: 0.4em 1.1em; min-height: 40px; font-size: 0.9rem; }
</style>

<script>
  const toggle = document.getElementById('menu-toggle')!;
  const nav = document.getElementById('site-nav')!;

  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Open navigation menu' : 'Close navigation menu');
    nav.classList.toggle('is-open', !open);
  });

  nav.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open navigation menu');
      nav.classList.remove('is-open');
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav.classList.contains('is-open')) {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open navigation menu');
      nav.classList.remove('is-open');
      toggle.focus();
    }
  });
</script>
