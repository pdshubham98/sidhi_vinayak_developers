---
import { site } from '../config/site';
import { userRoleOptions, lookingForOptions, callbackTimeOptions } from '../lib/form-options';
---

<div
  id="popup-cta"
  class="popup-cta"
  role="dialog"
  aria-modal="true"
  aria-labelledby="popup-heading"
  hidden
>
  <div class="popup-cta__backdrop"></div>
  <div class="popup-cta__box">
    <button class="popup-cta__close" aria-label="Close" id="popup-close">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>

    <!-- Form state -->
    <div id="popup-form-state">
      <p class="popup-cta__eyebrow">Your dream property awaits</p>
      <h2 class="popup-cta__heading" id="popup-heading">Quick Enquiry</h2>
      <p class="popup-cta__body">Tell us what you need — we'll call you back personally.</p>

      <form id="popup-inquiry-form" novalidate>
        <div class="popup-form-row">
          <div class="popup-field">
            <label for="popup-name" class="popup-label">Your name <span class="required" aria-hidden="true">*</span></label>
            <input id="popup-name" name="name" class="popup-input" required autocomplete="name" placeholder="Full name" />
          </div>
          <div class="popup-field">
            <label for="popup-phone" class="popup-label">Mobile <span class="required" aria-hidden="true">*</span></label>
            <input id="popup-phone" name="phone" type="tel" class="popup-input" required autocomplete="tel" placeholder="10-digit number" />
          </div>
        </div>

        <fieldset class="popup-fieldset">
          <legend class="popup-label">I am a… <span class="required" aria-hidden="true">*</span></legend>
          <div class="popup-choices">
            {userRoleOptions.map(o => (
              <label class="popup-choice">
                <input type="radio" name="userRole" value={o.value} />
                {o.label}
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="popup-fieldset">
          <legend class="popup-label">What are you looking for? <span class="required" aria-hidden="true">*</span></legend>
          <div class="popup-choices">
            {lookingForOptions.map(o => (
              <label class="popup-choice">
                <input type="radio" name="lookingFor" value={o.value} />
                {o.label}
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="popup-fieldset">
          <legend class="popup-label">Best time to call you back</legend>
          <div class="popup-choices">
            {callbackTimeOptions.map(o => (
              <label class="popup-choice">
                <input type="radio" name="callbackTime" value={o.value} />
                {o.label}
              </label>
            ))}
          </div>
        </fieldset>

        <label class="popup-consent-label">
          <input type="checkbox" name="consent" id="popup-consent" />
          I agree to be contacted by {site.name}.
        </label>

        <p id="popup-form-error" class="popup-error" hidden>Please fill in your name, mobile, and tick the consent box.</p>

        <button type="submit" class="btn btn-primary popup-submit">Submit Enquiry</button>
      </form>
    </div>

    <!-- Success state -->
    <div id="popup-success" class="popup-success" hidden>
      <div class="popup-success__icon">
        <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 15 10"/></svg>
      </div>
      <h2>Enquiry received!</h2>
      <p>Thank you. We'll call you back shortly.</p>
    </div>
  </div>
</div>

<style>
  .popup-cta {
    position: fixed;
    inset: 0;
    z-index: 900;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 1rem;
  }
  @media (min-width: 500px) {
    .popup-cta { align-items: center; }
  }
  .popup-cta[hidden] { display: none; }

  .popup-cta__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(23,41,34,0.55);
    backdrop-filter: blur(2px);
  }

  .popup-cta__box {
    position: relative;
    background: #fff;
    border-radius: var(--radius-lg);
    padding: 2rem 1.75rem 1.75rem;
    max-width: 460px;
    width: 100%;
    box-shadow: 0 20px 60px rgba(23,41,34,0.25);
    animation: popup-slide-up 0.3s ease;
    max-height: 92vh;
    overflow-y: auto;
  }
  @keyframes popup-slide-up {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .popup-cta__box { animation: none; }
  }

  .popup-cta__close {
    position: sticky;
    float: right;
    top: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--sage);
    border: none;
    border-radius: var(--radius);
    cursor: pointer;
    color: var(--ink);
    transition: background 0.15s;
    margin-bottom: 0.25rem;
  }
  .popup-cta__close:hover { background: var(--line); }

  .popup-cta__eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.4rem;
  }
  .popup-cta__heading {
    font-size: 1.4rem;
    margin-bottom: 0.4rem;
  }
  .popup-cta__body {
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }

  /* Form layout */
  .popup-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  @media (max-width: 380px) {
    .popup-form-row { grid-template-columns: 1fr; }
  }

  .popup-field { display: flex; flex-direction: column; gap: 0.3rem; }

  .popup-label {
    font-weight: 600;
    font-size: 0.875rem;
    display: block;
  }

  .popup-input {
    padding: 0.55em 0.75em;
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    font-size: 0.9rem;
    font-family: inherit;
    width: 100%;
    min-height: 44px;
    color: var(--ink);
    background: #fff;
  }
  .popup-input:focus { outline: 2px solid var(--forest); outline-offset: 1px; border-color: var(--forest); }

  .popup-fieldset {
    border: none;
    padding: 0;
    margin: 0 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .popup-choices { display: flex; flex-wrap: wrap; gap: 0.35rem; }

  .popup-choice {
    display: flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.35em 0.65em;
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    cursor: pointer;
    font-size: 0.82rem;
    min-height: 36px;
    user-select: none;
    transition: border-color 0.15s, background 0.15s;
  }
  .popup-choice:has(input:checked) {
    border-color: var(--forest);
    background: var(--sage);
  }
  .popup-choice input { accent-color: var(--forest); }

  .popup-consent-label {
    display: flex;
    align-items: flex-start;
    gap: 0.5em;
    font-size: 0.82rem;
    cursor: pointer;
    margin-bottom: 1rem;
    line-height: 1.4;
  }
  .popup-consent-label input {
    margin-top: 0.1em;
    accent-color: var(--forest);
    flex-shrink: 0;
  }

  .popup-error {
    color: #c0392b;
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
  }

  .popup-submit {
    width: 100%;
    justify-content: center;
    min-height: 48px;
  }

  /* Success state */
  .popup-success {
    text-align: center;
    padding: 1.5rem 0 0.5rem;
  }
  .popup-success__icon {
    color: var(--forest);
    margin-bottom: 0.75rem;
  }
  .popup-success h2 {
    font-size: 1.4rem;
    margin-bottom: 0.5rem;
  }
  .popup-success p {
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>

<script>
  import { isValidPhone, sendLead } from '../scripts/lead';

  (function () {
    var STORAGE_KEY = 'sdv_popup_dismissed';
    var DELAY_MS = 8000;

    function dismissed() {
      try {
        var ts = localStorage.getItem(STORAGE_KEY);
        if (!ts) return false;
        return (Date.now() - parseInt(ts)) < 7 * 24 * 60 * 60 * 1000;
      } catch { return false; }
    }

    function dismiss() {
      try { localStorage.setItem(STORAGE_KEY, String(Date.now())); } catch {}
      var el = document.getElementById('popup-cta');
      if (el) el.hidden = true;
    }

    if (dismissed()) return;

    var interacted = false;
    var events = ['click', 'keydown', 'scroll', 'touchstart'];

    function onInteract() {
      interacted = true;
      events.forEach(function(e) { document.removeEventListener(e, onInteract); });
    }
    events.forEach(function(e) { document.addEventListener(e, onInteract, { passive: true }); });

    setTimeout(function () {
      if (interacted) return;
      var el = document.getElementById('popup-cta');
      if (!el) return;
      el.hidden = false;

      var closeBtn = document.getElementById('popup-close');
      if (closeBtn) closeBtn.addEventListener('click', dismiss);

      var backdrop = el.querySelector('.popup-cta__backdrop');
      if (backdrop) backdrop.addEventListener('click', dismiss);

      // Form submission
      var form = document.getElementById('popup-inquiry-form') as HTMLFormElement | null;
      var errEl = document.getElementById('popup-form-error');
      if (form) {
        form.addEventListener('submit', function(e) {
          e.preventDefault();
          var data = new FormData(e.currentTarget as HTMLFormElement);
          var name = (data.get('name') || '').toString().trim();
          var phone = (data.get('phone') || '').toString().trim();
          var consent = data.get('consent');

          if (!name || !isValidPhone(phone) || !consent) {
            if (errEl) errEl.hidden = false;
            return;
          }
          if (errEl) errEl.hidden = true;

          var payload: Record<string, string> = { formType: 'popup-inquiry', name: name, phone: phone };
          ['userRole', 'lookingFor', 'callbackTime'].forEach(function(k) {
            var val = data.get(k);
            if (val) payload[k] = val.toString();
          });
          sendLead(payload);

          // Show success
          var formState = document.getElementById('popup-form-state');
          var successState = document.getElementById('popup-success');
          if (formState) formState.hidden = true;
          if (successState) successState.hidden = false;

          // Auto-dismiss after 3s
          setTimeout(dismiss, 3000);
        });
      }
    }, DELAY_MS);
  })();
</script>
