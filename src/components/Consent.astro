---
interface Props {
  error?: string;
  checked?: boolean;
}
const { error, checked = false } = Astro.props;
const errorId = 'consent-error';
---

<div class="form-group">
  <label class="consent-label">
    <input
      type="checkbox"
      name="consent"
      value="true"
      checked={checked}
      aria-required="true"
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={error ? errorId : undefined}
    />
    <span>
      I agree to be contacted by Siddhivinayak Developers about my enquiry. See our
      <a href="/privacy" target="_blank">privacy policy</a>.
    </span>
  </label>
  {error && <p id={errorId} class="field-error" role="alert">{error}</p>}
</div>
