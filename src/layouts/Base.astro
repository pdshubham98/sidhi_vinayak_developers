---
import { site } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import '../styles/global.css';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description?: string;
  /** Canonical URL for this page (full URL). */
  canonical?: string;
  /** Open Graph image URL. */
  ogImage?: string;
  /** Breadcrumb trail for BreadcrumbList schema. First item is always Home. */
  breadcrumbs?: BreadcrumbItem[];
  /** Extra JSON-LD blocks to inject (e.g. FAQPage, RealEstateListing). */
  extraSchemas?: object[];
}

const {
  title,
  description = site.description,
  canonical,
  ogImage,
  breadcrumbs,
  extraSchemas = [],
} = Astro.props;

const pageTitle = title === site.name ? site.name : `${title} – ${site.name}`;

// Auto-generate canonical from current URL when Astro.site is set
const canonicalUrl = canonical ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined);

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': ['RealEstateAgent', 'LocalBusiness'],
  name: site.name,
  description: site.description,
  url: Astro.site ? String(Astro.site) : undefined,
  ...(site.contact.phone ? { telephone: site.contact.phone } : {}),
  ...(site.contact.email ? { email: site.contact.email } : {}),
  ...(site.contact.hours ? { openingHours: site.contact.hours } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.office.lines[0],
    addressLocality: 'Bhopal',
    addressRegion: 'Madhya Pradesh',
    postalCode: '462044',
    addressCountry: 'IN',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: '23.1765',
    longitude: '77.4346',
  },
  areaServed: [
    { '@type': 'City', name: 'Bhopal' },
    { '@type': 'State', name: 'Madhya Pradesh' },
  ],
  keywords: 'plots in Bhopal, farm house plots Bhopal, property in Bhopal, plots near Bilkisganj, Neelbad property, Madhya Pradesh real estate',
  ...(site.office.mapUrl ? { hasMap: site.office.mapUrl } : {}),
};

const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site ? String(Astro.site).replace(/\/$/, '') + '/' : '/' },
    ...breadcrumbs.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name: b.name,
      item: b.url,
    })),
  ],
} : null;

const allSchemas = [businessSchema, ...(breadcrumbSchema ? [breadcrumbSchema] : []), ...extraSchemas];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  {!site.indexable && <meta name="robots" content="noindex, nofollow" />}
  {site.indexable && <meta name="robots" content="index, follow" />}
  {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Geo / local SEO -->
  <meta name="geo.region" content="IN-MP" />
  <meta name="geo.placename" content="Bhopal, Madhya Pradesh" />
  <meta name="geo.position" content="23.1765;77.4346" />
  <meta name="ICBM" content="23.1765, 77.4346" />

  <!-- Open Graph -->
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:locale" content="en_IN" />
  <meta property="og:site_name" content={site.name} />

  <!-- Structured data -->
  {allSchemas.map(schema => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <Header />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
  <MobileBar />
  <WhatsAppFloat />
</body>
</html>
