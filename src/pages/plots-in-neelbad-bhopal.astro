---
import Base from '../layouts/Base.astro';
import PropertyCard from '../components/PropertyCard.astro';
import { site, whatsappHref } from '../config/site';
import { url } from '../lib/url';
import { getProperties } from '../lib/properties';

const properties = await getProperties();
const AREA_IDS = ['kanha-dream-city', 'siddhivinayak-phase-2'];
const areaProjects = AREA_IDS
  .map((id) => properties.find((p) => p.id === id))
  .filter((p) => p !== undefined);

const available = areaProjects.filter((p) => p.data.status !== 'sold');

const areaSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Plot projects by Sidhivinayak Developers in the Neelbad area of Bhopal',
  itemListElement: areaProjects.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.data.title,
    url: Astro.site ? new URL(`/properties/${p.id}`, Astro.site).toString() : undefined,
  })),
};
---

<Base
  title="Plots in Neelbad, Bhopal – Residential Plots on Ratibad Road"
  description="Residential plots in Neelbad, Bhopal from Sidhivinayak Developers. Kanha Dream City on Neelbad–Ratibad Road, and our completed Siddhi Vinayak Campus Phase 2 near Neelbad Chouraha. Direct from the developer, no middlemen."
  breadcrumbs={[{ name: 'Plots in Neelbad', url: '/plots-in-neelbad-bhopal' }]}
  extraSchemas={[areaSchema]}
>
  <section class="page-hero">
    <div class="container">
      <h1>Plots in Neelbad, Bhopal</h1>
      <p>
        Neelbad is where our office is and where we have built most of our plots. Below are the
        projects we have developed in this area — one selling now, one completed and handed over.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <h2>Our plot projects in the Neelbad area</h2>
        <p>
          Both are company-owned plotted colonies. You buy directly from us, so there is no agent
          commission on top of the plot price.
        </p>
      </div>
      <div class="property-grid">
        {areaProjects.map((p) => <PropertyCard property={p} />)}
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--sage);">
    <div class="container" style="max-width:820px;">
      <div class="section-heading">
        <h2>Where Neelbad sits in Bhopal</h2>
        <p>
          These are the distances we measured from our Siddhi Vinayak Campus Phase 2 site on
          Neelbad–Mendori Road. They give you a fair idea of the area generally.
        </p>
      </div>
      <ul class="highlights-list">
        <li>1 km from Neelbad Chouraha</li>
        <li>7 km from Bhadbhada Dam</li>
        <li>10 km from New Market</li>
        <li>14 km from Rani Kamlapati Railway Station</li>
      </ul>
      <p style="margin-top:1.25rem;color:var(--muted);">
        Kanha Dream City is on the Neelbad–Ratibad Road near Rajdhaba, a little further along the
        same corridor. The best way to judge the location is to stand on the plot — tell us when
        suits you and we will take you there ourselves.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:820px;">
      <div class="section-heading">
        <h2>What is in our Neelbad colonies</h2>
        <p>Every plot we sell in this area comes with the colony work already done.</p>
      </div>
      <ul class="highlights-list">
        <li>25-foot wide RCC internal roads</li>
        <li>Plot demarcations with corner pillars</li>
        <li>Electrification and street lights</li>
        <li>Water line and sewage line</li>
        <li>Park and children's play ground</li>
        <li>Radha Krishna and Jain Temple inside Kanha Dream City</li>
        <li>Commercial shops within the colony</li>
      </ul>
      <p style="margin-top:1.25rem;color:var(--muted);">
        Plot sizes and current prices change as plots sell, so we do not publish them. Call us and
        we will tell you exactly what is left and at what rate. See also our{' '}
        <a href={url('/buying-a-plot-in-bhopal')}>guide to buying a plot in Bhopal</a> for the
        documents and registration steps.
      </p>
    </div>
  </section>

  <section class="section" style="background:var(--sage);">
    <div class="container" style="max-width:820px;">
      <h2 style="font-size:1.4rem;margin-bottom:0.5rem;">Come and see a plot in Neelbad</h2>
      <p style="color:var(--muted);margin-bottom:1.5rem;">
        Our office is at {site.office.lines.join(', ')}.{site.contact.hours ? ` We are open ${site.contact.hours}.` : ''}
        {available.length > 0 ? ' Plots are available now — a site visit takes about an hour.' : ''}
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:0.75rem;">
        <a href={url('/requirement')} class="btn btn-primary">Book a site visit</a>
        {site.contact.whatsapp && (
          <a
            href={whatsappHref(site.contact.whatsapp, 'Hello, I am interested in plots in Neelbad, Bhopal.')}
            class="btn btn-outline"
            target="_blank"
            rel="noopener"
          >WhatsApp us</a>
        )}
        {site.contact.phone && (
          <a href={`tel:${site.contact.phone.replace(/\s/g, '')}`} class="btn btn-outline">Call {site.contact.phone}</a>
        )}
      </div>
    </div>
  </section>
</Base>
