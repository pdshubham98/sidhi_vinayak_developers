---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import { getProperties } from '../lib/properties';
import PropertyCard from '../components/PropertyCard.astro';
import PlotGrid from '../components/PlotGrid.astro';
import { url } from '../lib/url';

const allProperties = await getProperties();
const featured = allProperties.find(p => p.data.featured);
const latest = allProperties.filter(p => !p.data.featured).slice(0, 3);
---

<Base
  title={site.name}
  description="Buy plots and farm house plots near Bhopal, build your home, or sell your property. Vatika Green Farm House near Bilkisganj. Office in Neelbad, Bhopal."
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero__inner">
        <div>
          <p class="hero__eyebrow">Plots &amp; farm houses · Bhopal, Madhya Pradesh</p>
          <h1>Plots and farm houses around Bhopal</h1>
          <p class="hero__sub">
            Buy a plot or farm house near Bilkisganj, build your home in Bhopal,
            or sell your property. We work personally with every client.
          </p>

          <nav class="hero-paths" aria-label="What are you looking for?">
            <a href={url('/properties')} class="hero-path">
              <span class="hero-path__icon">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/><path d="M11 8v6M8 11h6"/></svg>
              </span>
              <span class="hero-path__label">
                I want to buy
                <span class="hero-path__sub">Farm house plots and residential plots</span>
              </span>
            </a>
            <a href={url('/construction')} class="hero-path">
              <span class="hero-path__icon">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/><line x1="17" y1="5" x2="22" y2="5"/><line x1="19.5" y1="2.5" x2="19.5" y2="7.5"/></svg>
              </span>
              <span class="hero-path__label">
                I want to build a house
                <span class="hero-path__sub">Construction on your plot in Bhopal</span>
              </span>
            </a>
            <a href={url('/sell')} class="hero-path">
              <span class="hero-path__icon">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
              </span>
              <span class="hero-path__label">
                I want to sell
                <span class="hero-path__sub">List your property with us</span>
              </span>
            </a>
          </nav>
        </div>

        <div>
          <PlotGrid />
        </div>
      </div>
    </div>
  </section>

  <!-- Featured project -->
  {featured && (
    <section class="section featured-section">
      <div class="container">
        <div class="section-heading">
          <h2>Vatika Green Farm House, Khuraniya</h2>
          <p>Farm house plots at Vatika Green Parisar, Khuraniya, near Bilkisganj, Bhopal — a planned layout with an internal road and trees.</p>
        </div>
        <div class="featured-layout">
          <div class="featured-card-wrap">
            <PropertyCard property={featured} showCta={false} />
          </div>
          <div class="featured-cta-wrap">
            <p class="featured-cta-desc">Visit the site in person, see the layout, and ask us anything. We are available Mon to Sat.</p>
            <div class="featured-cta-btns">
              <a href={url('/requirement?need=farm-house')} class="btn btn-ochre">
                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                Book a site visit
              </a>
              <a href={url('/properties/vatika-green-farm-house')} class="btn btn-outline-light">
                See full details
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Latest listings -->
  {latest.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-heading">
          <h2>Latest properties in Bhopal</h2>
          <p>Plots and houses currently listed. Prices on request — call or send your requirement.</p>
        </div>
        <div class="property-grid">
          {latest.map(p => <PropertyCard property={p} />)}
        </div>
        <div style="margin-top:1.75rem;">
          <a href={url('/properties')} class="btn btn-outline">See all properties</a>
        </div>
      </div>
    </section>
  )}

  <!-- What we do -->
  <section class="section" style="background:var(--sage);">
    <div class="container">
      <div class="section-heading">
        <h2>What we do</h2>
        <p>A family business based in Neelbad, Bhopal. We sell plots, handle resale, and build homes — personally, without agents or middlemen.</p>
      </div>
      <div class="service-grid">
        <div class="service-card">
          <div class="service-card__icon">
            <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          </div>
          <h3>Plot and farm house sales</h3>
          <p>Residential plots and farm house plots around Bhopal, including our Vatika Green project near Bilkisganj.</p>
          <a href={url('/properties')} class="service-link">Browse properties</a>
        </div>
        <div class="service-card">
          <div class="service-card__icon">
            <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
          </div>
          <h3>Resale</h3>
          <p>Buying and selling residential and commercial properties in Bhopal. We help both sides find the right match.</p>
          <a href={url('/sell')} class="service-link">List your property</a>
        </div>
        <div class="service-card">
          <div class="service-card__icon">
            <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/><line x1="17" y1="5" x2="22" y2="5"/><line x1="19.5" y1="2.5" x2="19.5" y2="7.5"/></svg>
          </div>
          <h3>House construction</h3>
          <p>Build your home on your plot in Bhopal. We guide you from design and approvals through to handover.</p>
          <a href={url('/construction')} class="service-link">How it works</a>
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="section">
    <div class="container">
      <div style="max-width:640px;">
        <h2>About Siddhivinayak Developers</h2>
        <div class="about-text">
          <p>
            We are a family-run real estate business based in Neelbad, Bhopal, Madhya Pradesh.
            We focus on residential plots and farm house land around Bhopal — buying, selling, and construction.
          </p>
          <p>
            Our current project is Vatika Green Farm House at Khuraniya, near Bilkisganj.
            We are personally involved in every transaction, from the first site visit to registration.
          </p>
          <p>
            Our office is at Plot No. 31, AM Point, Near Durga Mandir, Neelbad, Bhopal.
          </p>
        </div>
        <a href={url('/contact')} class="btn btn-outline" style="margin-top:1.5rem;">Get in touch</a>
      </div>
    </div>
  </section>

  <!-- How a purchase works -->
  <section class="section" style="background:var(--sage);">
    <div class="container">
      <div class="section-heading">
        <h2>How a purchase works</h2>
        <p>Four straightforward steps from your first call to registration in Bhopal.</p>
      </div>
      <div class="steps">
        <div class="step">
          <h3>Share your requirement</h3>
          <p>Tell us what you are looking for and your budget. We find the right options for you.</p>
        </div>
        <div class="step">
          <h3>Book a site visit</h3>
          <p>We take you to see the property in Bhopal or near Bilkisganj. Ask every question — we answer plainly.</p>
        </div>
        <div class="step">
          <h3>Finalise the deal</h3>
          <p>Agree on the price and terms. We handle the paperwork and verify all documents.</p>
        </div>
        <div class="step">
          <h3>Registration</h3>
          <p>The property is registered in your name at the Bhopal sub-registrar office. We stay available throughout.</p>
        </div>
      </div>
      <div style="margin-top:2rem;">
        <a href={url('/faq')} class="btn btn-outline">Read frequently asked questions</a>
      </div>
    </div>
  </section>

  <!-- Sell banner -->
  <section class="section">
    <div class="container">
      <div class="sell-banner">
        <div class="sell-banner__text">
          <h2>Want to sell your property in Bhopal?</h2>
          <p>Share the details and we will connect you with genuine buyers.</p>
        </div>
        <a href={url('/sell')} class="btn btn-primary">List your property</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Featured section layout */
  .featured-layout {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 768px) {
    .featured-layout { grid-template-columns: 380px 1fr; }
  }
  .featured-card-wrap { max-width: 420px; }
  .featured-cta-wrap {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-top: 0.5rem;
  }
  .featured-cta-desc {
    color: rgba(255,255,255,0.75);
    font-size: 1.05rem;
    max-width: 44ch;
    line-height: 1.7;
  }
  .featured-cta-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .btn-ochre {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.65em 1.4em;
    border: 2px solid var(--ochre);
    border-radius: var(--radius);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    min-height: 48px;
    background: var(--ochre);
    color: var(--ink);
    transition: background 0.15s, border-color 0.15s;
  }
  .btn-ochre:hover { background: #b5751f; border-color: #b5751f; }
  .btn-outline-light {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.65em 1.4em;
    border: 2px solid rgba(255,255,255,0.35);
    border-radius: var(--radius);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    min-height: 48px;
    background: transparent;
    color: #fff;
    transition: background 0.15s, border-color 0.15s;
  }
  .btn-outline-light:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.55); }

  /* Service card link */
  .service-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-weight: 600;
    color: var(--forest);
    font-size: 0.9rem;
    text-decoration: none;
    border-bottom: 1.5px solid transparent;
    transition: border-color 0.15s;
  }
  .service-link:hover { border-bottom-color: var(--forest); }

  /* Service card icon */
  .service-card__icon { color: var(--forest); margin-bottom: 0.9rem; line-height: 0; }

  /* About text */
  .about-text { margin-top: 1rem; color: #4a6054; display: flex; flex-direction: column; gap: 0.75rem; max-width: 60ch; }

  /* Hero path icon alignment */
  .hero-path__icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 32px; height: 32px; }
</style>
