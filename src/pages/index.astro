---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import { getProperties } from '../lib/properties';
import { statusLabels, statusBadgeClass, formatPrice } from '../lib/property-meta';
import PropertyCard from '../components/PropertyCard.astro';
import { url, asset } from '../lib/url';

const allProperties = await getProperties();
const ongoing = allProperties.filter(p => p.data.status !== 'sold');
const completed = allProperties.filter(p => p.data.status === 'sold');
// The highlighted project: the one marked featured, else the first ongoing one.
const featured = ongoing.find(p => p.data.featured) ?? ongoing[0];
const otherOngoing = ongoing.filter(p => p !== featured);
const featuredImage = featured?.data.images?.[0];
const needFor = (type: string) => (type === 'farm-house-plot' ? 'farm-house' : 'plot');
---

<Base
  title={site.name}
  description={site.description}
>
  <!-- ─── Hero ─────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container">
      <div class="hero__inner">
        <div class="hero__content">
          <h1 class="hero__headline">Find your land.<br />Build your dream.</h1>
          <p class="hero__desc">
            Plots and farmhouses near Bhopal, home construction on your plot, and help selling
            your property, all handled personally by our family.
          </p>
          <div class="hero__actions">
            <a href={url('/requirement')} class="btn btn-gold">Book a site visit</a>
          </div>
        </div>

        <nav class="hero__visual" aria-label="What would you like to do?">
          <div class="hero__paths">
            <a href={url('/properties')} class="hero-path">
              <span class="hero-path__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="8" height="8" rx="1"/><rect x="14" y="3" width="8" height="8" rx="1"/><rect x="2" y="13" width="8" height="8" rx="1"/><rect x="14" y="13" width="8" height="8" rx="1"/></svg>
              </span>
              <span>
                <strong>Buy a plot or farmhouse</strong>
                <span>See our projects around Bhopal</span>
              </span>
              <svg class="arrow" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href={url('/construction')} class="hero-path">
              <span class="hero-path__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              </span>
              <span>
                <strong>Build your home</strong>
                <span>Construction on your plot in Bhopal</span>
              </span>
              <svg class="arrow" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href={url('/sell')} class="hero-path">
              <span class="hero-path__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
              </span>
              <span>
                <strong>Sell your property</strong>
                <span>List your property with us</span>
              </span>
              <svg class="arrow" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </nav>
      </div>
    </div>
  </section>

  <!-- ─── Our projects ──────────────────────────────────────────── -->
  <section class="section" id="projects">
    <div class="container">
      <div class="section-heading">
        <h2>Our projects</h2>
        <p>Plots and farmhouse plots we develop and sell directly, with no middlemen.</p>
      </div>

      {featured && (
        <article class="featured">
          <a href={url(`/properties/${featured.id}`)} class="featured__image" tabindex="-1" aria-hidden="true">
            {featuredImage && <img src={asset(featuredImage.src)} alt="" width="960" height="600" />}
            {featuredImage?.placeholder && <span class="badge badge-sample featured__tag">Photo coming soon</span>}
          </a>
          <div class="featured__body">
            <span class={`badge ${statusBadgeClass[featured.data.status]}`}>{statusLabels[featured.data.status]}</span>
            <h3 class="featured__title"><a href={url(`/properties/${featured.id}`)}>{featured.data.title}</a></h3>
            <p class="featured__loc">{featured.data.location}</p>
            <p class="featured__desc">{featured.data.summary}</p>
            {featured.data.highlights && featured.data.highlights.length > 0 && (
              <ul class="featured__highlights">
                {featured.data.highlights.slice(0, 3).map((h) => <li>{h}</li>)}
              </ul>
            )}
            <p class="featured__price">
              {formatPrice(featured.data.price)}{featured.data.size && <span> · {featured.data.size}</span>}
            </p>
            <div class="featured__actions">
              <a href={url(`/requirement?need=${needFor(featured.data.type)}`)} class="btn btn-primary">Book a site visit</a>
              <a href={url(`/properties/${featured.id}`)} class="btn btn-ghost">See details</a>
            </div>
          </div>
        </article>
      )}

      {otherOngoing.length > 0 && (
        <div class="property-grid" style="margin-top:1.5rem;">
          {otherOngoing.map(p => <PropertyCard property={p} />)}
        </div>
      )}

      {completed.length > 0 && (
        <div class="completed">
          <h3 class="completed__title">Completed projects</h3>
          <div class="property-grid">
            {completed.map(p => <PropertyCard property={p} />)}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- ─── Why us ────────────────────────────────────────────────── -->
  <section class="section why-section">
    <div class="container">
      <div class="why-layout">
        <div class="why-text">
          <h2>A personal approach to property in Bhopal</h2>
          <p>
            Sidhivinayak Developers is a family business based in Neelbad, Bhopal.
            We do not work through agents. Every client works directly with us —
            from the first site visit to registration and beyond.
          </p>
          <div class="why-points">
            <div class="why-point">
              <div class="why-point__icon">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </div>
              <div>
                <h4>Personal attention</h4>
                <p>You deal with us directly — no middlemen, no confusion.</p>
              </div>
            </div>
            <div class="why-point">
              <div class="why-point__icon">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <h4>Local knowledge</h4>
                <p>Deep knowledge of Bhopal, Neelbad, Bilkisganj, and surrounding areas.</p>
              </div>
            </div>
            <div class="why-point">
              <div class="why-point__icon">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
              </div>
              <div>
                <h4>Clear information</h4>
                <p>We verify all property documents and guide you through the registration process.</p>
              </div>
            </div>
            <div class="why-point">
              <div class="why-point__icon">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.15 12 19.79 19.79 0 0 1 1.08 3.45 2 2 0 0 1 3.06 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <div>
                <h4>Always reachable</h4>
                <p>Call or WhatsApp us — we respond quickly, Mon to Sat.</p>
              </div>
            </div>
          </div>
          <a href={url('/about')} class="btn btn-outline" style="margin-top:1.5rem;">About us</a>
        </div>
        <div class="why-steps">
          <h2 class="why-steps__title">From first call to registration</h2>
          <div class="process-steps">
            <div class="process-step">
              <div class="process-step__num">1</div>
              <div>
                <h4>Share your requirement</h4>
                <p>Tell us what you need and your budget.</p>
              </div>
            </div>
            <div class="process-step">
              <div class="process-step__num">2</div>
              <div>
                <h4>Visit the property</h4>
                <p>We take you to the site and answer every question plainly.</p>
              </div>
            </div>
            <div class="process-step">
              <div class="process-step__num">3</div>
              <div>
                <h4>Finalise and verify</h4>
                <p>Agree on terms, we verify all documents.</p>
              </div>
            </div>
            <div class="process-step">
              <div class="process-step__num">4</div>
              <div>
                <h4>Registration</h4>
                <p>Property registered in your name at the Bhopal sub-registrar office.</p>
              </div>
            </div>
          </div>
          <a href={url('/requirement')} class="btn btn-primary" style="margin-top:1.5rem;">Start with a site visit</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Sell or partner ───────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="sell-banner">
        <div class="sell-banner__col">
          <h2>Selling a property in Bhopal?</h2>
          <p>Share the details and we will connect you with genuine buyers. No commission talk upfront, just a conversation.</p>
          <a href={url('/sell')} class="btn btn-gold">List your property</a>
        </div>
        <div class="sell-banner__col">
          <h2>Broker or landowner?</h2>
          <p>We work directly with trusted partners across Neelbad, Bilkisganj and Kolar Road. Refer buyers or list your land through us.</p>
          <a href={url('/contact') + '?role=broker'} class="btn btn-outline-white">Partner with us</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Hero ── */
  .hero {
    background: var(--forest-deep);
    color: #fff;
    padding-block: clamp(3rem, 7vw, 5.5rem);
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 60% at 70% 40%, rgba(211,161,75,0.07) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero__inner {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero__inner { grid-template-columns: 1fr 420px; }
  }
  .hero__headline {
    font-size: clamp(2.25rem, 5.5vw, 3.5rem);
    color: #fff;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }
  .hero__desc {
    font-size: 1.1rem;
    color: rgba(255,255,255,0.72);
    max-width: 48ch;
    line-height: 1.7;
    margin-bottom: 2rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ── Hero path rows ── */
  .hero__paths {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .hero-path {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.1rem;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: var(--radius-lg);
    color: #fff;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }
  .hero-path:hover { background: rgba(255,255,255,0.11); border-color: rgba(255,255,255,0.25); }
  .hero-path__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: rgba(211,161,75,0.15);
    border-radius: var(--radius);
    flex-shrink: 0;
    color: var(--gold);
  }
  .hero-path strong { display: block; font-size: 0.95rem; font-weight: 600; }
  .hero-path span span { display: block; font-size: 0.8rem; color: rgba(255,255,255,0.55); margin-top: 0.1rem; }
  .hero-path .arrow { margin-left: auto; opacity: 0.4; flex-shrink: 0; }

  /* ── Gold and outline-white buttons ── */
  .btn-gold {
    background: var(--gold);
    color: var(--ink);
    border-color: var(--gold);
  }
  .btn-gold:hover { background: #c4902e; border-color: #c4902e; }
  .btn-outline-white {
    background: transparent;
    color: #fff;
    border-color: rgba(255,255,255,0.35);
  }
  .btn-outline-white:hover { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.55); }
  .btn-whatsapp {
    background: #25d366;
    color: #fff;
    border-color: #25d366;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }
  .btn-whatsapp:hover { background: #1da851; border-color: #1da851; }

  /* ── Featured project ── */
  .featured {
    display: grid;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  @media (min-width: 860px) {
    .featured { grid-template-columns: 1.1fr 1fr; }
  }
  .featured__image {
    position: relative;
    display: block;
    background: var(--paper);
    aspect-ratio: 4/3;
    align-self: center;
  }
  /* contain: layout plans and brochures must not be cropped */
  .featured__image img { width: 100%; height: 100%; object-fit: contain; }
  .featured__tag { position: absolute; left: 0.75rem; bottom: 0.75rem; }
  .featured__body {
    padding: clamp(1.25rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .featured__title { font-family: var(--font-serif); font-weight: 400; font-size: clamp(1.4rem, 3vw, 1.9rem); line-height: 1.2; }
  .featured__title a { text-decoration: none; }
  .featured__title a:hover { color: var(--forest); }
  .featured__loc { color: var(--muted); font-size: 0.95rem; }
  .featured__desc { line-height: 1.65; max-width: 52ch; }
  .featured__highlights { list-style: none; display: flex; flex-direction: column; gap: 0.3rem; }
  .featured__highlights li { font-size: 0.95rem; padding-left: 1.2em; position: relative; }
  .featured__highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ochre);
  }
  .featured__price { font-weight: 600; color: var(--forest-deep); margin-top: 0.25rem; }
  .featured__price span { font-weight: 400; color: var(--muted); }
  .featured__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }

  .completed { margin-top: clamp(2rem, 5vw, 3rem); }
  .completed__title { font-size: 1.1rem; margin-bottom: 1rem; color: var(--muted); }

  /* ── Why section ── */
  .why-section { background: var(--sage); }
  .why-layout {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: start;
  }
  @media (min-width: 900px) {
    .why-layout { grid-template-columns: 1fr 1fr; }
  }
  .why-text h2 { margin-bottom: 1rem; }
  .why-text > p { color: var(--muted); max-width: 52ch; margin-bottom: 1.75rem; line-height: 1.7; }
  .why-points { display: flex; flex-direction: column; gap: 1.25rem; }
  .why-point {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .why-point__icon {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    background: #fff;
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--forest);
    box-shadow: 0 1px 3px rgba(23,63,45,0.1);
  }
  .why-steps__title { font-size: clamp(1.4rem, 3vw, 1.75rem); margin-bottom: 1.5rem; }
  .why-point h4 { font-size: 0.95rem; margin-bottom: 0.2rem; }
  .why-point p { font-size: 0.875rem; color: var(--muted); }

  /* ── Process steps ── */
  .process-steps { display: flex; flex-direction: column; gap: 1rem; }
  .process-step {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1rem 1.25rem;
    background: #fff;
    border-radius: var(--radius);
    border-left: 3px solid var(--gold);
  }
  .process-step__num {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    color: var(--gold);
    line-height: 1;
    flex-shrink: 0;
    min-width: 24px;
  }
  .process-step h4 { font-size: 0.95rem; margin-bottom: 0.2rem; }
  .process-step p { font-size: 0.85rem; color: var(--muted); }

  /* ── Sell / partner banner ── */
  .sell-banner {
    display: grid;
    align-items: start;
    gap: 2rem;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    background: var(--forest-deep);
    color: #fff;
    border-radius: var(--radius-lg);
  }
  @media (min-width: 760px) {
    .sell-banner { grid-template-columns: 1fr 1fr; gap: 3rem; }
    .sell-banner__col + .sell-banner__col { border-left: 1px solid rgba(255,255,255,0.15); padding-left: 3rem; }
  }
  .sell-banner__col { display: flex; flex-direction: column; align-items: flex-start; gap: 0.6rem; }
  .sell-banner__col h2 { color: #fff; font-size: clamp(1.3rem, 2.5vw, 1.6rem); }
  .sell-banner__col p { color: rgba(255,255,255,0.8); line-height: 1.65; max-width: 48ch; margin-bottom: 0.5rem; }
</style>
