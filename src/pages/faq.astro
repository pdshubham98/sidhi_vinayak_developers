---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';

const faqs = [
  {
    q: 'What types of properties does Siddhivinayak Developers offer?',
    a: 'We offer farm house plots, residential plots, and resale properties in and around Bhopal, Madhya Pradesh. We also provide house construction services on your own plot. Our first project, Vatika Green Farm House, is a planned farm house layout near Bilkisganj.',
  },
  {
    q: 'Where is Vatika Green Farm House located?',
    a: 'Vatika Green Farm House is at Vatika Green Parisar, Khuraniya, near Bilkisganj, Bhopal. The layout has plots on both sides of an internal road with trees. Call us or share your requirement for current availability, plot sizes, and to arrange a site visit.',
  },
  {
    q: 'How do I book a site visit?',
    a: 'Call us, send a WhatsApp message, or fill out the "Share your requirement" form on this website. We will confirm a convenient time and take you to the site personally.',
  },
  {
    q: 'What documents do I need to buy a plot in Madhya Pradesh?',
    a: 'You will typically need your Aadhaar card, PAN card, and passport-size photographs for registration. We verify all property documents — title deed, encumbrance certificate, and layout approvals — before any transaction, and we guide you through the registration process at the Bhopal sub-registrar office.',
  },
  {
    q: 'What is the plot registration process in Bhopal?',
    a: 'Once you finalise a plot, both buyer and seller visit the sub-registrar office in Bhopal to execute the sale deed. Stamp duty and registration charges are paid at that time. We handle the paperwork and accompany you to make the process smooth.',
  },
  {
    q: 'Can you build a house on my plot?',
    a: 'Yes. We offer house construction services on your plot anywhere around Bhopal. We handle the design, approvals, and construction, and give you regular updates. Share your requirement and we will visit the site and give you an estimate.',
  },
  {
    q: 'I want to sell my property. Can you help?',
    a: 'Yes. Fill out the "Sell your property" form or call us. We assess the property, suggest a realistic price, and connect you with genuine buyers. We handle plots, farm land, houses, flats, and commercial properties.',
  },
  {
    q: 'What is the price range for plots at Vatika Green?',
    a: 'Prices depend on the plot size and location within the layout. Call us or share your requirement and we will give you the current pricing. We do not list prices online because they change with availability.',
  },
  {
    q: 'Are your properties RERA registered?',
    a: 'RERA registration requirements depend on project size and type under the RERA Act (MP). We will confirm the registration status of each project when you enquire. We recommend buyers always verify registration with the MP RERA portal.',
  },
  {
    q: 'Where is your office?',
    a: `Our office is at ${site.office.lines.join(', ')}. ${site.contact.hours ? `We are open ${site.contact.hours}.` : ''} You can also reach us by phone or WhatsApp.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<Base
  title="Frequently asked questions"
  description="Answers to common questions about buying plots, farm house land, and house construction in Bhopal. How to book a site visit, documents needed, and registration process."
  breadcrumbs={[{ name: 'FAQ', url: '/faq' }]}
  extraSchemas={[faqSchema]}
>
  <section class="page-hero">
    <div class="container">
      <h1>Frequently asked questions</h1>
      <p>Common questions about buying plots, selling property, and house construction in Bhopal.</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:780px;">
      <div class="faq-list" itemscope itemtype="https://schema.org/FAQPage">
        {faqs.map(({ q, a }, i) => (
          <details class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
            <summary class="faq-question" itemprop="name">
              {q}
              <span class="faq-icon" aria-hidden="true"></span>
            </summary>
            <div class="faq-answer" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
              <p itemprop="text">{a}</p>
            </div>
          </details>
        ))}
      </div>

      <div style="margin-top:3rem;padding:2rem;background:var(--sage);border-radius:var(--radius-lg);">
        <h2 style="font-size:1.3rem;margin-bottom:0.4rem;">Still have a question?</h2>
        <p style="color:#4a6054;margin-bottom:1.25rem;">Call us or send a message and we will get back to you quickly.</p>
        <div style="display:flex;flex-wrap:wrap;gap:0.75rem;">
          <a href="/contact" class="btn btn-primary">Send a message</a>
          {site.contact.phone && (
            <a href={`tel:${site.contact.phone.replace(/\s/g,'')}`} class="btn btn-outline">Call us</a>
          )}
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .faq-list { display: flex; flex-direction: column; gap: 0; }

  .faq-item {
    border-bottom: 1px solid var(--line);
  }
  .faq-item:first-child { border-top: 1px solid var(--line); }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 0;
    cursor: pointer;
    font-weight: 600;
    font-size: 1.05rem;
    list-style: none;
    color: var(--ink);
    user-select: none;
  }
  .faq-question::-webkit-details-marker { display: none; }

  .faq-icon {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1.5px solid var(--line);
    position: relative;
    transition: border-color 0.15s, background 0.15s;
  }
  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    background: var(--forest);
    border-radius: 2px;
    transition: transform 0.2s;
  }
  .faq-icon::before { top: 50%; left: 4px; right: 4px; height: 1.5px; transform: translateY(-50%); }
  .faq-icon::after  { left: 50%; top: 4px; bottom: 4px; width: 1.5px; transform: translateX(-50%); }

  details[open] .faq-icon { background: var(--sage); border-color: var(--forest); }
  details[open] .faq-icon::after { transform: translateX(-50%) rotate(90deg); opacity: 0; }

  .faq-question:hover { color: var(--forest); }
  .faq-question:hover .faq-icon { border-color: var(--forest); }

  .faq-answer {
    padding: 0 0 1.1rem 0;
    color: #4a6054;
    line-height: 1.7;
    max-width: 68ch;
  }
</style>
