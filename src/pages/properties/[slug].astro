---
import Base from '../../layouts/Base.astro';
import { typeLabels, statusLabels, statusBadgeClass, formatPrice, getProperties } from '../../lib/properties';
import { site, telHref, whatsappHref } from '../../config/site';
import { url, asset } from '../../lib/url';

// Used only by the prerendered GitHub Pages build.
export async function getStaticPaths() {
  return (await getProperties()).map((p) => ({ params: { slug: p.id } }));
}

const { slug } = Astro.params;
const property = (await getProperties()).find((p) => p.id === slug);

// An empty 404 makes Astro serve the prerendered 404 page with a real 404 status.
if (!property) return new Response(null, { status: 404 });

const { title, type, status, location, price, size, offer, summary, description, highlights, images, sample, ownershipType, updatedAt, listedOn, mapUrl } = property.data;

const statusClass = statusBadgeClass[status];

// Hide "photo coming soon" placeholders once a listing has at least one real photo.
const realImages = images.filter((img) => !img.placeholder);
const gallery = (realImages.length > 0 ? realImages : images).map((img) => ({ ...img, src: asset(img.src) }));
const mainImage = gallery[0];
const siteVisitHref = url(`/requirement?need=${type === 'farm-house-plot' ? 'farm-house' : 'plot'}&property=${encodeURIComponent(title)}`);

const whatsappLink = site.contact.whatsapp
  ? whatsappHref(site.contact.whatsapp, `Hi, I'm interested in the property: ${title} in ${location}. Please share more details.`)
  : null;

const listingSchema = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateListing',
  name: title,
  description: summary,
  url: Astro.site ? `${String(Astro.site).replace(/\/$/, '')}/properties/${slug}` : undefined,
  ...(price ? { price, priceCurrency: 'INR' } : {}),
  ...(size ? { floorSize: { '@type': 'QuantitativeValue', description: size } } : {}),
  address: {
    '@type': 'PostalAddress',
    addressLocality: location,
    addressRegion: 'Madhya Pradesh',
    addressCountry: 'IN',
  },
  ...(mainImage && !mainImage.placeholder ? { image: Astro.site ? new URL(mainImage.src, Astro.site).toString() : mainImage.src } : {}),
};
---

<Base
  title={`${title} – ${location}`}
  description={`${summary} ${size ? size + '. ' : ''}${formatPrice(price)}. ${location}, Bhopal.`}
  breadcrumbs={[
    { name: 'Properties', url: '/properties' },
    { name: title, url: `/properties/${slug}` },
  ]}
  extraSchemas={[listingSchema]}
>
  <section class="page-hero">
    <div class="container">
      <div style="display:flex;flex-wrap:wrap;align-items:center;gap:0.75rem;margin-bottom:0.75rem;">
        <span class={`badge ${statusClass}`}>{statusLabels[status]}</span>
        <span class="badge" style="background:rgba(255,255,255,0.15);color:rgba(255,255,255,0.9);">{typeLabels[type]}</span>
        {sample && <span class="badge badge-sample">Sample listing</span>}
      </div>
      <h1>{title}</h1>
      <p style="display:flex;align-items:center;gap:0.4em;color:rgba(255,255,255,0.8);">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        {location}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="property-detail">
        {mainImage && (
          <div class="property-gallery detail-gallery">
            <div class="gallery-strip" id="gallery-strip" tabindex="0" aria-label="Photos">
              {gallery.map((img, i) => (
                <figure class="gallery-slide" id={`photo-${i + 1}`}>
                  {img.placeholder ? (
                    <img src={img.src} alt={img.alt} width="960" height="720" loading={i === 0 ? 'eager' : 'lazy'} />
                  ) : (
                    <a href={img.src} target="_blank" rel="noopener" title="Open full size">
                      <img src={img.src} alt={img.alt} width="960" height="720" loading={i === 0 ? 'eager' : 'lazy'} />
                    </a>
                  )}
                  {img.placeholder && <span class="badge badge-sample gallery-slide__tag">Photo coming soon</span>}
                </figure>
              ))}
            </div>
            {gallery.length > 1 && (
              <div class="property-gallery__thumbs">
                {gallery.map((img, i) => (
                  <a class="property-gallery__thumb" href={`#photo-${i + 1}`} data-slide={i} aria-label={`Show photo ${i + 1} of ${gallery.length}`}>
                    <img src={img.src} alt="" width="160" height="120" loading="lazy" />
                  </a>
                ))}
              </div>
            )}
            {gallery.length > 1 && <p class="gallery-hint">Swipe or tap a thumbnail to see all {gallery.length} photos. Tap a photo to open it full size.</p>}
          </div>
        )}

        <aside class="detail-sidebar">
          <div class="detail-sidebar-card">
            <div class="detail-price">
              <div class="detail-price__value">{formatPrice(price)}</div>
              {size && <div class="detail-price__size">{size}</div>}
              {offer && <div style="margin-top:0.5rem;"><span class="property-card__offer">{offer}</span></div>}
            </div>

            <div class="detail-actions">
              {status === 'sold' ? (
                <a href={url('/properties')} class="btn btn-primary">See available projects</a>
              ) : (
                <a href={siteVisitHref} class="btn btn-primary">Book a site visit</a>
              )}
              {(whatsappLink || site.contact.phone) && (
                <div class="detail-actions__row">
                  {whatsappLink && (
                    <a href={whatsappLink} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.38 1.25 4.79L2.05 22l5.42-1.42c1.35.73 2.9 1.14 4.56 1.14h.01c5.45 0 9.9-4.45 9.9-9.91S17.49 2 12.04 2zm0 18.13c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.24 8.24 0 0 1-1.26-4.37c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c-.01 4.54-3.7 8.22-8.22 8.22zm4.52-6.16c-.25-.12-1.47-.72-1.69-.8-.23-.08-.39-.12-.56.12-.17.25-.64.8-.78 1-.15.2-.29.21-.54.08-.25-.12-.95-.35-1.8-.11-.69.21-1.12.69-1.29.9-.17.21-.09.31.09.41.27.14 1.42.92 1.97 2.17.54 1.24-.39 2.64-.52 2.83-.13.2-.39.25-.58.16-.2-.09-.82-.3-1.56-.95-.58-.52-.97-1.16-1.08-1.35-.11-.2-.01-.3.09-.4.09-.09.2-.24.3-.35.1-.12.13-.2.2-.33.06-.14.03-.26-.02-.35-.05-.1-.56-1.35-.77-1.85-.2-.49-.4-.42-.56-.43-.14-.01-.31-.01-.47-.01-.17 0-.44.06-.66.31-.23.25-.87.85-.87 2.07s.89 2.4 1.01 2.57c.13.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.23-.15-.48-.27z"/></svg>
                      WhatsApp
                    </a>
                  )}
                  {site.contact.phone && (
                    <a href={telHref(site.contact.phone)} class="btn btn-ghost">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.15 12 19.79 19.79 0 0 1 1.08 3.45 2 2 0 0 1 3.06 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                      Call
                    </a>
                  )}
                </div>
              )}
              {mapUrl && (
                <a href={mapUrl} class="detail-map-link" target="_blank" rel="noopener noreferrer">
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                  View location on Google Maps
                </a>
              )}
            </div>

            {(site.contact.hours || updatedAt || listedOn) && (
              <p class="detail-meta">
                {site.contact.hours}
                {site.contact.hours && (updatedAt || listedOn) && <br />}
                {updatedAt
                  ? `Updated ${updatedAt.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}`
                  : listedOn && `Listed ${listedOn.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}`
                }
              </p>
            )}
          </div>
        </aside>

        <div class="detail-content">
          <p class="ownership-notice">
            {ownershipType === 'own'
              ? 'Developed and sold directly by us. You deal with the family, not an agent.'
              : 'Assisted listing: details are shared by the owner, and we verify documents before any deal.'}
          </p>

          {description && (
            <div style="margin-bottom:2rem;">
              <h2 class="detail-h2">About this property</h2>
              <p>{description}</p>
            </div>
          )}

          {highlights && highlights.length > 0 && (
            <div style="margin-bottom:2rem;">
              <h2 class="detail-h2">Highlights</h2>
              <ul class="highlights-list">
                {highlights.map(h => <li>{h}</li>)}
              </ul>
            </div>
          )}

          <p class="detail-links">
            <a href={url('/faq')}>Questions about buying a plot? Read the FAQ</a>
            <a href={url('/properties')}>← All properties</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .property-detail {
    grid-template-areas: "gallery" "aside" "content";
  }
  @media (min-width: 900px) {
    .property-detail {
      grid-template-areas: "gallery aside" "content aside";
      grid-template-rows: auto 1fr;
    }
  }
  .detail-gallery { grid-area: gallery; min-width: 0; }
  .detail-sidebar { grid-area: aside; }
  .detail-content { grid-area: content; min-width: 0; }

  .gallery-strip {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    border-radius: var(--radius-lg);
    background: var(--sage);
    scrollbar-width: none;
  }
  .gallery-strip::-webkit-scrollbar { display: none; }
  .gallery-slide {
    position: relative;
    flex: 0 0 100%;
    aspect-ratio: 4/3;
    scroll-snap-align: start;
  }
  .gallery-slide a { display: block; width: 100%; height: 100%; cursor: zoom-in; }
  /* contain, not cover: layout plans and brochures must not be cropped */
  .gallery-slide img { width: 100%; height: 100%; object-fit: contain; }
  .gallery-slide__tag { position: absolute; left: 0.75rem; bottom: 0.75rem; }
  .property-gallery__thumb[aria-current="true"] { outline: 2px solid var(--forest); outline-offset: 2px; }
  .gallery-hint { font-size: 0.85rem; color: var(--muted); }

  .detail-price { margin-bottom: 1.25rem; }
  .detail-price__value { font-size: 1.5rem; font-weight: 700; color: var(--forest-deep); line-height: 1.3; }
  .detail-price__size { font-size: 0.95rem; color: var(--muted); margin-top: 0.2rem; }
  .detail-actions { display: flex; flex-direction: column; gap: 0.6rem; }
  .detail-actions .btn { justify-content: center; }
  .detail-actions__row { display: grid; grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); gap: 0.6rem; }
  .detail-map-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    min-height: 44px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--forest);
  }
  .detail-meta {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    font-size: 0.8rem;
    color: var(--muted);
    text-align: center;
  }

  .ownership-notice {
    font-size: 0.95rem;
    color: var(--muted);
    padding-left: 0.9rem;
    border-left: 3px solid var(--ochre);
    margin-bottom: 1.75rem;
  }
  .detail-h2 { font-size: 1.3rem; margin-bottom: 0.75rem; }
  .detail-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
    font-weight: 600;
  }
  .detail-links a { color: var(--forest); }

  @media (max-width: 899px) {
    .detail-sidebar { position: static; }
  }
</style>

<script>
  // Thumbnails scroll the photo strip instead of jumping the page; highlight the current one.
  const strip = document.getElementById('gallery-strip');
  const thumbs = [...document.querySelectorAll<HTMLAnchorElement>('.property-gallery__thumb[data-slide]')];
  if (strip && thumbs.length) {
    const mark = (i: number) => thumbs.forEach((t, j) => t.setAttribute('aria-current', String(i === j)));
    mark(0);
    thumbs.forEach((t, i) => t.addEventListener('click', (e) => {
      e.preventDefault();
      strip.scrollTo({ left: i * strip.clientWidth });
      mark(i);
    }));
    let raf = 0;
    strip.addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => mark(Math.round(strip.scrollLeft / strip.clientWidth)));
    }, { passive: true });
  }
</script>
