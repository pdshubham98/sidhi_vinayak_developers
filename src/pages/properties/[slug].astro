---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { typeLabels, statusLabels, ownershipLabels, formatPrice } from '../../lib/properties';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const properties = await getCollection('properties');
  return properties.map(p => ({ params: { slug: p.id } }));
}

const { slug } = Astro.params;
const properties = await getCollection('properties');
const property = properties.find(p => p.id === slug);

if (!property) {
  return Astro.redirect('/404');
}

const { title, type, status, location, price, size, offer, summary, description, highlights, images, sample, ownershipType, updatedAt, listedOn } = property.data;

const statusClass = {
  available: 'badge-available',
  booked: 'badge-booked',
  sold: 'badge-sold',
  upcoming: 'badge-upcoming',
}[status];

const mainImage = images?.[0];
const thumbImages = images?.slice(1) ?? [];

const whatsappMsg = `Hi, I'm interested in the property: ${title} in ${location}. Please share more details.`;
const whatsappLink = site.contact.whatsapp
  ? `https://wa.me/${site.contact.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(whatsappMsg)}`
  : null;

// RealEstateListing structured data
const listingSchema = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateListing',
  name: title,
  description: summary,
  url: Astro.site ? `${String(Astro.site).replace(/\/$/, '')}/properties/${slug}` : undefined,
  ...(price ? { price, priceCurrency: 'INR' } : {}),
  ...(size ? { floorSize: { '@type': 'QuantitativeValue', description: size } } : {}),
  address: {
    '@type': 'PostalAddress',
    addressLocality: location,
    addressRegion: 'Madhya Pradesh',
    addressCountry: 'IN',
  },
  ...(mainImage && !mainImage.placeholder ? { image: mainImage.src } : {}),
};
import { url } from '../../lib/url';
---

<Base
  title={`${title} – ${location}`}
  description={`${summary} ${size ? size + '. ' : ''}${formatPrice(price)}. ${location}, Bhopal.`}
  breadcrumbs={[
    { name: 'Properties', url: '/properties' },
    { name: title, url: `/properties/${slug}` },
  ]}
  extraSchemas={[listingSchema]}
>
  <section class="page-hero">
    <div class="container">
      <div style="display:flex;flex-wrap:wrap;align-items:center;gap:0.75rem;margin-bottom:0.75rem;">
        <span class={`badge ${statusClass}`}>{statusLabels[status]}</span>
        <span class="badge" style="background:rgba(255,255,255,0.15);color:rgba(255,255,255,0.9);">{typeLabels[type]}</span>
        {ownershipType === 'own' && <span class="badge" style="background:var(--gold);color:var(--forest-deep);font-weight:700;">Our project</span>}
        {sample && <span class="badge badge-sample">Sample listing</span>}
      </div>
      <h1>{title}</h1>
      <p style="display:flex;align-items:center;gap:0.4em;color:rgba(255,255,255,0.8);">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        {location}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="property-detail">
        <!-- Main content -->
        <div>
          <!-- Gallery -->
          {mainImage && (
            <div class="property-gallery" style="margin-bottom:2rem;">
              <div class="property-gallery__main" style="position:relative;">
                <img src={mainImage.src} alt={mainImage.alt} width="960" height="720" />
                {mainImage.placeholder && (
                  <div style="position:absolute;bottom:0.75rem;left:0.75rem;">
                    <span class="badge badge-sample">Photo coming soon</span>
                  </div>
                )}
              </div>
              {thumbImages.length > 0 && (
                <div class="property-gallery__thumbs">
                  {thumbImages.map(img => (
                    <div class="property-gallery__thumb">
                      <img src={img.src} alt={img.alt} width="160" height="120" loading="lazy" />
                    </div>
                  ))}
                </div>
              )}
            </div>
          )}

          <!-- Ownership disclosure -->
          <div class="ownership-notice" data-type={ownershipType}>
            {ownershipType === 'own' ? (
              <>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                <span><strong>Our project</strong> — this property is directly owned and sold by Sidhivinayak Developers. You deal with us, not an agent.</span>
              </>
            ) : (
              <>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                <span><strong>Assisted listing</strong> — we are assisting the seller with this property. All details shared by the owner; we verify documents before any transaction.</span>
              </>
            )}
          </div>

          <!-- Description -->
          {description && (
            <div style="margin-bottom:2rem;">
              <h2 style="font-size:1.3rem;margin-bottom:0.75rem;">About this property</h2>
              <p>{description}</p>
            </div>
          )}

          <!-- Highlights -->
          {highlights && highlights.length > 0 && (
            <div style="margin-bottom:2rem;">
              <h2 style="font-size:1.3rem;margin-bottom:0.75rem;">Highlights</h2>
              <ul class="highlights-list">
                {highlights.map(h => <li>{h}</li>)}
              </ul>
            </div>
          )}

          <!-- FAQ teaser -->
          <div style="margin-bottom:2rem;padding:1.25rem;background:var(--sage);border-radius:var(--radius-lg);">
            <p style="font-weight:600;margin-bottom:0.25rem;">Have questions about buying a plot in Bhopal?</p>
            <p style="font-size:0.9rem;color:var(--muted);margin-bottom:0.75rem;">We've answered the most common ones — documents needed, registration process, and more.</p>
            <a href={url('/faq')} style="font-size:0.9rem;font-weight:600;color:var(--forest);">Read the FAQ</a>
          </div>

          <div style="margin-top:1rem;">
            <a href={url('/properties')} style="font-size:0.9rem;color:var(--forest);font-weight:600;">← Back to all properties</a>
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="detail-sidebar">
          <div class="detail-sidebar-card">
            <div style="margin-bottom:1.25rem;">
              <div style="font-size:1.5rem;font-weight:700;color:var(--forest-deep);">{formatPrice(price)}</div>
              {size && <div style="font-size:0.9rem;color:var(--muted);margin-top:0.2rem;">{size}</div>}
              {offer && (
                <div style="margin-top:0.5rem;">
                  <span class="property-card__offer">{offer}</span>
                </div>
              )}
            </div>

            <div style="display:flex;flex-direction:column;gap:0.6rem;">
              <a href={url(`/requirement?need=${type === 'farm-house-plot' ? 'farm-house' : 'plot'}`)} class="btn btn-primary" style="justify-content:center;">
                Book a site visit
              </a>
              <a href={url(`/contact?property=${encodeURIComponent(title)}`)} class="btn btn-outline" style="justify-content:center;">
                Send an enquiry
              </a>
              {whatsappLink && (
                <a href={whatsappLink} class="btn btn-ghost" target="_blank" rel="noopener noreferrer" style="justify-content:center;gap:0.4em;">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.38 1.25 4.79L2.05 22l5.42-1.42c1.35.73 2.9 1.14 4.56 1.14h.01c5.45 0 9.9-4.45 9.9-9.91S17.49 2 12.04 2zm0 18.13c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.24 8.24 0 0 1-1.26-4.37c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c-.01 4.54-3.7 8.22-8.22 8.22zm4.52-6.16c-.25-.12-1.47-.72-1.69-.8-.23-.08-.39-.12-.56.12-.17.25-.64.8-.78 1-.15.2-.29.21-.54.08-.25-.12-.95-.35-1.8-.11-.69.21-1.12.69-1.29.9-.17.21-.09.31.09.41.27.14 1.42.92 1.97 2.17.54 1.24-.39 2.64-.52 2.83-.13.2-.39.25-.58.16-.2-.09-.82-.3-1.56-.95-.58-.52-.97-1.16-1.08-1.35-.11-.2-.01-.3.09-.4.09-.09.2-.24.3-.35.1-.12.13-.2.2-.33.06-.14.03-.26-.02-.35-.05-.1-.56-1.35-.77-1.85-.2-.49-.4-.42-.56-.43-.14-.01-.31-.01-.47-.01-.17 0-.44.06-.66.31-.23.25-.87.85-.87 2.07s.89 2.4 1.01 2.57c.13.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.23-.15-.48-.27z"/></svg>
                  WhatsApp us
                </a>
              )}
              {site.contact.phone && (
                <a href={`tel:${site.contact.phone.replace(/\s/g,'')}`} class="btn btn-ghost" style="justify-content:center;gap:0.4em;">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.15 12 19.79 19.79 0 0 1 1.08 3.45 2 2 0 0 1 3.06 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                  Call us
                </a>
              )}
            </div>

            {site.contact.hours && (
              <p style="margin-top:1rem;font-size:0.8rem;color:var(--muted);text-align:center;">{site.contact.hours}</p>
            )}

            {(updatedAt || listedOn) && (
              <p style="margin-top:0.75rem;font-size:0.75rem;color:var(--muted);text-align:center;border-top:1px solid var(--line);padding-top:0.75rem;">
                {updatedAt
                  ? `Updated ${updatedAt.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}`
                  : `Listed ${listedOn.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}`
                }
              </p>
            )}
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  .ownership-notice {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius);
    font-size: 0.875rem;
    line-height: 1.55;
    margin-bottom: 1.75rem;
  }
  .ownership-notice[data-type="own"] {
    background: var(--ochre-light);
    color: #5a3f0a;
    border: 1px solid #e8c87a;
  }
  .ownership-notice[data-type="assisted"] {
    background: var(--sage);
    color: var(--ink);
    border: 1px solid var(--line);
  }
  .ownership-notice svg { flex-shrink: 0; margin-top: 2px; }
</style>
