---
import Base from '../../layouts/Base.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import { url } from '../../lib/url';
import { getProperties } from '../../lib/properties';

const properties = await getProperties();

const forSale   = properties.filter(p => p.data.status === 'available' || p.data.status === 'booked');
const upcoming  = properties.filter(p => p.data.status === 'upcoming');
const completed = properties.filter(p => p.data.status === 'sold');
---

<Base
  title="Plots in Bhopal for Sale – Residential & Farm House Plots"
  description="Residential plots and farm house plots for sale in Bhopal, Madhya Pradesh — Kanha Dream City, Vatika Green near Bilkisganj and upcoming projects. Direct from the owner, no middlemen, no commission."
  breadcrumbs={[{ name: 'Properties', url: '/properties' }]}
>
  <section class="page-hero">
    <div class="container">
      <h1>Plots in Bhopal for sale</h1>
      <p>Residential plots and farm house plots around Bhopal, Madhya Pradesh. Direct from us — no middlemen, no extra commission.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">

      {forSale.length > 0 && (
        <div class="listing-section">
          <div class="listing-section__header">
            <h2>Available for sale</h2>
            <p>Ready to visit. Call us or send an enquiry to arrange a site visit.</p>
          </div>
          <div class="property-grid">
            {forSale.map(p => <PropertyCard property={p} />)}
          </div>
        </div>
      )}

      {upcoming.length > 0 && (
        <div class="listing-section">
          <div class="listing-section__header">
            <h2>Upcoming projects</h2>
            <p>Launching soon. Register your interest for early-bird pricing.</p>
          </div>
          <div class="property-grid">
            {upcoming.map(p => <PropertyCard property={p} />)}
          </div>
        </div>
      )}

      {completed.length > 0 && (
        <div class="listing-section">
          <div class="listing-section__header">
            <h2>Completed projects</h2>
            <p>Projects we have delivered and sold out.</p>
          </div>
          <div class="property-grid">
            {completed.map(p => <PropertyCard property={p} />)}
          </div>
        </div>
      )}

      {properties.length === 0 && (
        <p style="color:var(--muted);">No properties listed yet. Check back soon.</p>
      )}

      <div class="listing-cta">
        <p class="listing-cta__title">Can't find what you're looking for?</p>
        <p class="listing-cta__body">Share your requirement and we'll find the right property in Bhopal for you.</p>
        <a href={url('/requirement')} class="btn btn-primary">Send an enquiry</a>
      </div>

    </div>
  </section>
</Base>

<style>
  .listing-section { margin-bottom: 3rem; }
  .listing-section__header {
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--forest);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
  }
  .listing-section__header h2 { font-size: clamp(1.2rem, 2.5vw, 1.4rem); margin: 0; color: var(--forest-deep); }
  .listing-section__header p { font-size: 0.875rem; color: var(--muted); margin: 0; }
  .listing-cta { margin-top: 1rem; padding: 2rem; background: var(--sage); border-radius: var(--radius-lg); }
  .listing-cta__title { font-weight: 700; font-size: 1.1rem; margin-bottom: 0.4rem; }
  .listing-cta__body { color: var(--muted); font-size: 0.95rem; margin-bottom: 1rem; }
</style>
