---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base
  title="Thank you"
  description="Your message has been received. We will be in touch shortly."
>
  <section class="section">
    <div class="container">
      <div class="centered-page">
        <div style="font-size:3rem;margin-bottom:1rem;" aria-hidden="true">✅</div>
        <h1>Thank you</h1>
        <p>Your message has been received. We will be in touch with you shortly.</p>
        <a href={url('/')} class="btn btn-primary">Back to home</a>
      </div>
    </div>
  </section>
</Base>
